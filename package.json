{
  "name": "supibot",
  "version": "2.2.0",
  "type": "module",
  "dependencies": {
    "@jprochazk/roll-dice": "^0.4.2",
    "acorn-node": "^2.0.1",
    "async-markov": "supinic/async-markov",
    "chrono-node": "^2.10.1",
    "cron": "^4.4.0",
    "cytube-connector": "supinic/cytube-connector",
    "discord.js": "14.27.0",
    "irc-framework": "^4.14.0",
    "rss-parser": "^3.13.0",
    "supi-core": "supinic/supi-core",
    "track-link-parser": "supinic/track-link-parser",
    "transliteration": "^2.6.1",
    "vm2": "^3.12.2",
    "ws": "^8.21.3",
    "zod": "^4.6.5"
  },
  "engines": {
    "node": ">= 24.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "check": "tsc --noEmit --incremental false && yarn lint && yarn test",
    "start": "node --env-file=.env --enable-experimental-regexp-engine ./master.ts",
    "debug": "node --env-file=.env --enable-experimental-regexp-engine --inspect=0.0.0.0:9229 --unhandled-rejections=warn ./master.ts",
    "init-database": "node ./init/script.js",
    "auto-setup": "node --env-file=.env ./init/auto-setup.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "ncu": "yarn dlx npm-check-updates -c 7d -x typescript",
    "test": "node --test-reporter=dot --experimental-test-module-mocks --test",
    "indev": "yarn remove supi-core && yarn add supi-core@supinic/supi-core",
    "validate:config": "node ./utils/validate-config.ts"
  },
  "main": "master.ts",
  "author": "Supinic <supinic@protonmail.com>",
  "repository": "github:Supinic/supibot",
  "license": "AGPL-3.0",
  "description": "Multiplatform, utility & novelty chat bot.",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "eslint": "^10.11.0",
    "eslint-plugin-unicorn": "^76.0.0",
    "globals": "^17.12.0",
    "supi-db-init": "supinic/supi-db-init",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1"
  },
  "packageManager": "yarn@4.18.0"
}
